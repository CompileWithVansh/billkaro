# ============================================================
# BillKaro Backend Environment Variables
# Copy this file to ".env" and fill in the values below.
# ============================================================

# Set to "production" when deploying. In production the server REQUIRES a
# strong JWT_SECRET (>=16 chars) and refuses to start without one.
NODE_ENV=development

# Port the server runs on (platforms like Render/Railway set this for you).
PORT=4000

# Secret used to sign JWT tokens. Use a long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret

# How long a login token stays valid
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------
# DATABASE (REQUIRED) — cloud Postgres. Data lives in the cloud, not on the
# server disk, so it survives redeploys and isn't tied to any machine.
#
# Free options: Neon (https://neon.tech) or Supabase (https://supabase.com).
# Create a database and paste its connection string here. BillKaro creates its
# own billkaro_* tables, so a database shared with another project is fine.
#
# Format: postgresql://user:password@host/dbname?sslmode=require
# ------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Only needed if you host the frontend on a DIFFERENT domain than the API.
# In the default single-process deploy the frontend is same-origin — leave blank.
CORS_ORIGIN=

# ------------------------------------------------------------
# NO EXTERNAL PAID KEYS ARE REQUIRED for billing. Payment QRs are generated
# on-device from each shop's own UPI ID (entered at registration/settings).
# ------------------------------------------------------------
